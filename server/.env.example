PORT=5000
HOST=127.0.0.1
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/jexolyt_admin
JWT_SECRET=replace-with-at-least-32-random-characters
SUPER_ADMIN_SETUP_KEY=replace-with-a-one-time-setup-secret
CLIENT_URL=http://localhost:5000,https://jexolyt.web.app
FIREBASE_PROJECT_ID=govindkr-dev
# Configure a private FIREBASE_SERVICE_ACCOUNT_JSON value or GOOGLE_APPLICATION_CREDENTIALS
# before using the admin-to-client-chat bridge. Never put service credentials in frontend files.
RESEND_API_KEY=
RESEND_FROM_EMAIL=JEXOLYT Chat <chat@your-verified-domain.com>
SUPPORT_INBOX_EMAIL=govindsh.dev@gmail.com